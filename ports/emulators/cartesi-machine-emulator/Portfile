PortSystem              1.0
PortGroup               github 1.0

github.setup            cartesi machine-emulator 0.22.0 v
github.tarball_from     archive
name                    cartesi-machine-emulator
categories              emulators
license                 LGPL-3+
platforms               darwin linux
maintainers             @cartesi/emulator \
                        @diegonehab
description             The Cartesi Machine Emulator
long_description    \
    The Cartesi Machine Emulator is a feature-rich RISC-V emulator \
    designed to support reproducible computations and fraud-proofs.
homepage                https://github.com/cartesi/machine-emulator
patchfiles              add-generated-files.diff
patch.pre_args          -p1
patch_sites             https://github.com/${github.author}/${github.project}/releases/download/${git.branch}/
checksums               ${distname}.tar.gz \
                        rmd160 a3b1d6f4677403016c5e4de75b5f3b03ab532ee6 \
                        sha256 7e82de5bfe213b9ca821a65c79a59dc593fff47ed6e8cf5accf36e9bb7b913fe \
                        size   2243177 \
                        add-generated-files.diff \
                        rmd160 c22359fe54c73dbc3bbcffa84dca5104158fbc87 \
                        sha256 f9050dd452caf8762aad0b74b59d5601aa64f44433dc691edc254b6e3f90d168 \
                        size   7262364
depends_build-append    port:pkgconfig
depends_lib-append      port:boost187 \
                        port:lua54 \
                        port:libslirp
use_configure           no
compiler.whitelist      macports-clang-20 \
                        macports-clang-21 \
                        macports-clang-22
build.args-append       CC=${configure.cc} \
                        CXX=${configure.cxx} \
                        CPP=${configure.cpp}
post-build {
    system -W ${worksrcpath}/src \
        "LUA_PATH_5_4='${worksrcpath}/src/?.lua;;' ${prefix}/bin/lua5.4 \
        -e 'rawset(arg, 1, rawget(arg, 0)); rawset(arg, 0, \"cartesi-machine.lua\"); \
        dofile(\"cartesi-machine.lua\")' -- --bash-completion > ${workpath}/cartesi-machine"
}
destroot.args-append    PREFIX=${prefix}
build.args-append       PREFIX=${prefix}
post-destroot {
    set docdir ${destroot}${prefix}/share/doc/cartesi-machine
    set bash_completion_dir ${destroot}${prefix}/share/bash-completion/completions
    xinstall -d -m 0755 ${docdir} ${bash_completion_dir}
    xinstall -m 0644 ${worksrcpath}/doc/README.md ${docdir}/README.md
    xinstall -m 0644 ${workpath}/cartesi-machine ${bash_completion_dir}/cartesi-machine
}
livecheck.type          none
